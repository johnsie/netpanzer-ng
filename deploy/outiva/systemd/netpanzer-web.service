[Unit]
Description=Outiva NetPanzer browser gateway
After=network-online.target netpanzer-game.service
Wants=network-online.target
Requires=netpanzer-game.service

[Service]
Type=simple
User=netpanzer
Group=netpanzer
WorkingDirectory=/opt/netpanzer-ng
Environment=NODE_ENV=production
EnvironmentFile=-/etc/netpanzer/oidc.env
ExecStart=/usr/bin/node support/web/server.mjs --bind=127.0.0.1 --port=8080 --dir=/srv/netpanzer/current --servers=/etc/netpanzer/servers.json --origin=https://netpanzer.outiva.com --trust-proxy --bots=0
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/netpanzer/current /etc/netpanzer

[Install]
WantedBy=multi-user.target
