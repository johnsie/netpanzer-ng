[Unit]
Description=Outiva NetPanzer dedicated game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netpanzer
Group=netpanzer
WorkingDirectory=/opt/netpanzer-ng
Environment=NETPANZER_DATADIR=/opt/netpanzer-ng/data
Environment=NETPANZER_USERDIR=/var/lib/netpanzer/
ExecStart=/opt/netpanzer-ng/build-native/netpanzer --dedicated --port=3030 --master_server=none --game_config=/config/server.cfg
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/netpanzer

[Install]
WantedBy=multi-user.target
